[-optional]
[+keeplinked]
[image=0x82000000]
[virtual=aarch64le,elf] boot = {
    # All 8 cores enabled by default (2xA520 + 4xA725 + 2xX925)
    # Add -P1 for single-core, -P2 for dual-core, etc.
    startup-tc3 -v -u arg
    PATH=/proc/boot:/sbin:/bin:/usr/bin:/usr/sbin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll procnto-smp-instr -v
}

[+script] startup-script = {
    SYSNAME=nto
    TERM=qansi
    ENV=/etc/profile
    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2
    pipe
    display_msg "=== QNX 8.0 on FVP_TC3 ==="
    # Serial console
    devc-serpl011 -e -F -b115200 0x2A400000,95
    waitfor /dev/ser1
    reopen /dev/ser1
    display_msg "Shell ready"
    slogger2

    # System services
    mqueue
    devc-pty

    # Entropy (seed file for FVP — no hardware TRNG)
    toybox cp /etc/random.seed /dev/shmem/random.seed
    random -s /dev/shmem/random.seed
    waitfor /dev/random 5

    # Writable /var/run via VirtIO block device (ext2 disk image from FVP)
    # devb-virtio-fvp: FVP workaround — stock devb-virtio hangs because
    # FVP returns QueueNumMax=256 for all queue indices (VirtIO spec bug)
    devb-virtio-fvp &
    waitfor /dev/vblk0 5
    # Copy ext2 image to shmem for devb-loopback (io-blk bridge)
    toybox dd if=/dev/vblk0 of=/dev/shmem/varrun.img bs=65536
    devb-loopback loopback fd=/dev/shmem/varrun.img &

    # Networking (SMSC LAN91C111)
    io-sock -m fdt -m phy -d smc
    waitfor /dev/socket 5

    # Mount ext2 from loopback device
    waitfor /dev/lo0 5
    mount -t ext2 /dev/lo0 /var/run

    # DHCP (FVP user networking: 172.20.51.0/24, gw 172.20.51.254)
    toybox sleep 3
    ifconfig smc0 up
    dhcpcd -bqq smc0
    # Static IP alternative (uncomment and comment out dhcpcd above):
    # ifconfig smc0 172.20.51.1 netmask 255.255.255.0 up
    # route add default 172.20.51.254

    # SSH server (ksh wrapper needed for absolute path requirement)
    ksh -c "/usr/sbin/sshd -h /etc/ssh/ssh_host_ed25519_key"
    display_msg "SSH: port 22"

    [+session] ksh &
}

[uid=0 gid=0]
[type=link] /bin/sh=/bin/ksh
[type=link] /tmp=/dev/shmem
[type=link] /dev/console=/dev/ser1
ldqnx-64.so.2=ldqnx-64.so.2
/lib/libc.so=libc.so
/lib/libm.so=libm.so
/lib/libgcc_s.so=libgcc_s.so
/lib/libsecpol.so=libsecpol.so
/lib/libslog2.so=libslog2.so
/lib/libslog2parse.so.1=libslog2parse.so.1
/lib/libtracelog.so=libtracelog.so
/lib/libregex.so=libregex.so
/lib/libqh.so=libqh.so
/lib/libslog2shim.so=libslog2shim.so
/lib/libcatalog.so=libcatalog.so
/lib/libdevice-publisher.so=libdevice-publisher.so
/lib/libfsnotify.so.1=libfsnotify.so.1
/usr/lib/libz.so.2=libz.so.2
/lib/libqcrypto.so.1.0=libqcrypto.so.1.0
/lib/dll/qcrypto-openssl-3.so=qcrypto-openssl-3.so
/lib/libcrypto.so.3=libcrypto.so.3
/usr/lib/libbacktrace.so=libbacktrace.so
/usr/lib/libc++.so=libc++.so
/lib/libsocket.so.4=libsocket.so.4
/usr/lib/libexpat.so.2=libexpat.so.2
/lib/libjail.so.1=libjail.so.1
# Networking
/sbin/io-sock=io-sock
/lib/dll/mods-fdt.so=mods-fdt.so
/lib/dll/mods-phy.so=mods-phy.so
/lib/dll/devs-vtnet_mmio.so=devs-vtnet_mmio.so
/lib/dll/devs-smc.so=devs-smc.so
/sbin/ifconfig=ifconfig
/sbin/ping=ping
/sbin/route=route
/sbin/dhcpcd=dhcpcd
/sbin/dhcpcd-run-hooks=${QNX_TARGET}/sbin/dhcpcd-run-hooks
[type=dir] /sbin/dhcpcd-hooks
/sbin/dhcpcd-hooks/20-resolv.conf=${QNX_TARGET}/sbin/dhcpcd-hooks/20-resolv.conf
# VirtIO block driver (FVP workaround) + loopback for ext2 mount
/sbin/devb-virtio-fvp=devb-virtio-fvp
/sbin/devb-loopback=${QNX_TARGET}/aarch64le/sbin/devb-loopback
/lib/libcam.so.2=libcam.so.2
/lib/dll/io-blk.so=io-blk.so
/lib/dll/cam-disk.so=cam-disk.so
/lib/dll/fs-ext2.so=fs-ext2.so
/bin/mount=mount
/sbin/sysctl=sysctl
# QVM hypervisor
/sbin/qvm=qvm
/usr/lib/libfdt.so=libfdt.so
/usr/lib/libfdt.so.1=libfdt.so.1
/lib/dll/vdev-pl011.so=vdev-pl011.so
/lib/dll/vdev-virtio-console.so=vdev-virtio-console.so
/lib/dll/vdev-virtio-net.so=vdev-virtio-net.so
# Guest files
# Guest files (hello-guest.bin copied to output/ by build-ifs.sh)
/guests/hello-guest.bin=hello-guest.bin
/guests/hello-guest.qvmconf = {
system hello-guest
ram 0x40000000,16M
cpu
load /guests/hello-guest.bin
vdev pl011
    loc 0x1c090000
    intr gic:37
}
/sbin/devc-serpl011=devc-serpl011
/sbin/pipe=pipe
/sbin/mqueue=mqueue
/bin/ksh=ksh
/bin/waitfor=waitfor
/bin/pidin=pidin
/bin/slog2info=slog2info
/bin/slogger2=slogger2
/usr/sbin/dumper=dumper
/usr/sbin/random=random
# SSH
/usr/sbin/sshd=${QNX_TARGET}/aarch64le/usr/sbin/sshd
/usr/libexec/sshd-session=${QNX_TARGET}/aarch64le/usr/libexec/sshd-session
/usr/libexec/sftp-server=${QNX_TARGET}/aarch64le/usr/libexec/sftp-server
/usr/bin/ssh-keygen=${QNX_TARGET}/aarch64le/usr/bin/ssh-keygen
/sbin/devc-pty=${QNX_TARGET}/aarch64le/sbin/devc-pty
/lib/libpam.so.2=${QNX_TARGET}/aarch64le/usr/lib/libpam.so.2
/usr/bin/toybox=toybox
[type=link] /bin/cat=/usr/bin/toybox
[type=link] /bin/ls=/usr/bin/toybox
[type=link] /bin/echo=/usr/bin/toybox
[type=link] /bin/uname=/usr/bin/toybox
[type=link] /bin/mkdir=/usr/bin/toybox
[type=link] /bin/chmod=/usr/bin/toybox
[type=link] /bin/rm=/usr/bin/toybox
[type=link] /bin/printf=/usr/bin/toybox
[uid=0 gid=0 perms=0644] /etc/random.seed=../configs/random.seed
[uid=0 gid=0 perms=0644] /etc/dhcpcd.conf = {
# DHCP client configuration
noipv6
}
[uid=0 gid=0 perms=0644] /etc/qcrypto.conf = {
openssl-3 tags=*
}
/etc/profile = {
export HOME=/
export SYSNAME=nto
export TERM=qansi
export PATH=/proc/boot:/sbin:/bin:/usr/bin:/usr/sbin
export LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll
export PS1="[QNX-FVP]# "
}
[uid=0 gid=0 perms=0644] /etc/passwd = {
root:x:0:0:Superuser:/root:/bin/sh
sshd:x:44:44:sshd privsep:/var/chroot/sshd:/bin/false
}
[uid=0 gid=0 perms=0644] /etc/shadow = {
root::1468494669:0:0
sshd:*:1468494669:0:0
}
[uid=0 gid=0 perms=0644] /etc/group = {
root:x:0:root
sshd:x:44:
}
# sshd config
[type=dir dperms=0755] /etc/ssh
[uid=0 gid=0 perms=0600] /etc/ssh/ssh_host_ed25519_key=../configs/ssh_host_ed25519_key
[uid=0 gid=0 perms=0644] /etc/ssh/sshd_config = {
Port 22
PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords yes
Subsystem sftp /usr/libexec/sftp-server
UseDns no
}
# Required directories
[type=dir] /var
[type=dir] /var/db
[type=dir] /var/run
[type=dir dperms=0755] /var/chroot
[type=dir dperms=0755] /var/chroot/sshd
[type=dir dperms=0700] /root
[type=dir dperms=0700] /root/.ssh
