#!/usr/bin/expect -f
# Automate QNX boot via U-Boot on FVP_TC3
# Just wait for U-Boot prompt and issue 'go <entry>'.
#
# Usage: boot-qnx.exp [entry_addr]

if {[llength $argv] >= 1} {
    set entry [lindex $argv 0]
} else {
    set entry "0x82000800"
}

set timeout 120
log_user 1

spawn telnet localhost 5002

expect {
    "Hit any key" {
        send "\r"
        exp_continue
    }
    "TOTAL_COMPUTE#" {
        send "\r"
    }
    timeout {
        puts "TIMEOUT waiting for U-Boot"
        exit 1
    }
}

sleep 1
expect "TOTAL_COMPUTE#"

# Jump to QNX startup, passing FDT address (loaded at DRAM+0x08000000)
# Same pattern as TI J784S4: go <ifs_addr> <fdt_addr>
puts "\n>>> go $entry 0x88000000"
send "go $entry 0x88000000\r"

# Wait for output
set timeout 90
expect {
    -re ".+" {
        exp_continue
    }
    timeout {
        puts "\n>>> TIMEOUT after go <<<"
    }
}
