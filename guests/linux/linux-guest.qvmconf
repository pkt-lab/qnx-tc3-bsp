# QVM configuration for Linux guest on TC3 FVP
#
# Usage: qvm @/guests/linux/linux-guest.qvmconf &

system linux-guest

# CNTVOFF=0: guest sees same counter as host (cross-VM time sync)
set counter-offset 0

# 256MB guest RAM
ram 0x40000000,256M

# 2 vCPUs
cpu
cpu

# Linux kernel Image
load 0x40200000,/guests/linux/Image

# Initramfs (explicit address — QVM auto-placement has invalid magic bug)
initrd load 0x48000000,/guests/linux/rootfs.cpio.gz

# Device tree overlay (required for QVM to set initrd info in FDT)
fdt load /guests/linux/linux-guest.dtb

# Kernel command line
cmdline "console=ttyAMA0 earlycon=pl011,0x1c090000 rdinit=/sbin/init loglevel=7"

# Virtual GIC v3
vdev gic version 3 gicd 0x2c000000 gicr 0x2c100000

# Virtual PL011 UART (console logged to /dev/shmem/linux-guest.log)
vdev pl011
    loc 0x1c090000
    intr gic:37
    hostdev >"|/usr/bin/toybox tee /dev/shmem/linux-guest.log"

# VirtIO net — host↔guest networking via vdevpeer
# Host side: io-sock loads mods-vdevpeer-net.so, creates vp0 interface
# Guest side: sees /dev/eth0 (virtio-net), configure with ip/dhcp
vdev virtio-net
    loc 0x1c0e0000
    intr gic:42
    peer /dev/qvm/linux-guest/vnet
    name vnet0

# VirtIO block for persistent guest rootfs (optional)
# Create guest-fs.img (ext4), place in host-disk.img
# Guest sees /dev/vda: mount /dev/vda /mnt
#vdev virtio-blk
#    loc 0x1c0d0000
#    intr gic:41
#    hostdev /guests/linux/guest-fs.img
